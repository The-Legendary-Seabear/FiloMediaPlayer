{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FiloMediaObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/users/*"
    },
    {
      "Sid": "FiloMediaBucketLookups",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": "users/*"
        }
      }
    }
  ]
}
