# Copy to .env on the server and fill in real values. Never commit .env.

# Public host name for the API (its DNS A record points at the EC2 instance).
FILO_DOMAIN=api.example.com

# PostgreSQL (Amazon RDS). Keep SSL on; RDS requires it by default.
FILO_DB_CONNECTION=Host=filo-db.xxxxxxxx.us-east-2.rds.amazonaws.com;Port=5432;Database=filo;Username=filo_app;Password=REPLACE_ME;SSL Mode=Require

# Existing S3 bucket and its region.
AWS_REGION=us-east-2
FILO_S3_BUCKET=filo-media-prod

# Shared secret between the API and the processing worker.
# Generate with:  openssl rand -base64 48
FILO_WORKER_KEY=REPLACE_ME

# Optional: name the worker reports when claiming jobs.
FILO_WORKER_ID=ec2-worker-1

# Image tag; change it for each deployment so you can roll back.
FILO_VERSION=1.0.0

# Only used with --profile local-db.
FILO_LOCAL_DB_PASSWORD=REPLACE_ME
