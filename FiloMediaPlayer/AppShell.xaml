<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="FiloMediaPlayer.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:FiloMediaPlayer.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="FiloMediaPlayer">

    <!-- Branded flyout header. Purely additive: no ShellContent, Route or
         FlyoutBehavior was changed, so navigation is untouched. -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{StaticResource Filo.Surface.Base}"
              HeightRequest="132">

            <Grid Padding="20,0"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="2"
                  VerticalOptions="Center">

                <Label Grid.Row="0"
                       Text="Filo"
                       Style="{StaticResource LargeTitle}"
                       TextColor="{StaticResource Filo.Accent.Hover}" />

                <Label Grid.Row="1"
                       Text="Media Player"
                       Style="{StaticResource Caption1}" />
            </Grid>

            <BoxView Style="{StaticResource Filo.Divider}"
                     VerticalOptions="End" />
        </Grid>
    </Shell.FlyoutHeader>

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="login" />

</Shell>
