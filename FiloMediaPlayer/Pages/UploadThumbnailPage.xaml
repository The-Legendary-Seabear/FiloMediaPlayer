<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FiloMediaPlayer.Pages.UploadThumbnailPage"
             Title="UploadThumbnailPage">
    <VerticalStackLayout>
        <HorizontalStackLayout>
            <Label x:Name="SelectedThumbnailName" Text="No File Selected"></Label>
            <Button Clicked="OnUploadThumbnailButton" HorizontalOptions="Center" VerticalOptions="Center" Text="Upload File"/>
        </HorizontalStackLayout>
        <Entry x:Name="UserUploadedThumbnailName" Placeholder="Enter Thumbnail Name" />
        <Button x:Name="UploadThumbnailButton" Clicked="OnFinalThumbnailButton" Text="Create Thumbnail" HorizontalOptions="Center" VerticalOptions="Center"/>
        <Grid
    x:Name="UploadStatusPanel"
    IsVisible="False">
            <Border Margin="20" Padding="20">
                <VerticalStackLayout>
                    <ActivityIndicator
x:Name="UploadActivityIndicator"
IsRunning="False" />

                    <Label
x:Name="UploadStatusLabel"
Text="Uploading..." />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </VerticalStackLayout>
</ContentPage>