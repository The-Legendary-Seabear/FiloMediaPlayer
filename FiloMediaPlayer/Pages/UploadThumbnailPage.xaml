<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FiloMediaPlayer.Pages.UploadThumbnailPage"
             Title="UploadThumbnailPage">

    <!-- Contract preserved: SelectedThumbnailName (initial text must stay
         "No File Selected" - code resets it to the defaultFileNamePlaceHolder
         constant of the same value), UserUploadedThumbnailName,
         UploadThumbnailButton, UploadStatusPanel (IsVisible, starts False),
         UploadActivityIndicator, UploadStatusLabel, OnUploadThumbnailButton,
         OnFinalThumbnailButton. -->

    <Grid>

        <ScrollView>
            <Grid Padding="{StaticResource Filo.Page.Padding}"
                  RowDefinitions="*,Auto,*">

                <VerticalStackLayout Grid.Row="1"
                                     Spacing="20"
                                     WidthRequest="480"
                                     MaximumWidthRequest="480"
                                     HorizontalOptions="Center">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Upload thumbnail"
                               Style="{StaticResource Filo.PageTitle}" />
                        <Label Text="Artwork you upload here can be assigned to any playlist or track."
                               Style="{StaticResource Caption1}" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Filo.Card}" Padding="24">
                        <VerticalStackLayout Spacing="18">

                            <!-- File picker -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Image file"
                                       Style="{StaticResource Filo.FieldLabel}" />

                                <Border Style="{StaticResource Filo.Panel}"
                                        BackgroundColor="{StaticResource Filo.Surface.Bg}"
                                        Padding="14">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                        <Border Grid.Column="0"
                                                Style="{StaticResource Filo.ThumbFrame}"
                                                WidthRequest="40"
                                                HeightRequest="40">
                                            <Image Source="{StaticResource Filo.Icon.ImagePlaceholder}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <Label Grid.Column="1"
                                               x:Name="SelectedThumbnailName"
                                               Text="No File Selected"
                                               Style="{StaticResource Body2}"
                                               VerticalOptions="Center"
                                               LineBreakMode="MiddleTruncation"
                                               MaxLines="1" />

                                        <Button Grid.Column="2"
                                                Text="Choose..."
                                                Style="{StaticResource Filo.Button.Secondary}"
                                                VerticalOptions="Center"
                                                Clicked="OnUploadThumbnailButton" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Title -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Thumbnail name"
                                       Style="{StaticResource Filo.FieldLabel}" />

                                <Border Style="{StaticResource Filo.InputShell}">
                                    <Entry x:Name="UserUploadedThumbnailName"
                                           Placeholder="Enter Thumbnail Name" />
                                </Border>
                            </VerticalStackLayout>

                            <Button x:Name="UploadThumbnailButton"
                                    Text="Create thumbnail"
                                    Style="{StaticResource Filo.Button.Primary}"
                                    ImageSource="{StaticResource Filo.Icon.UploadOnAccent}"
                                    ContentLayout="Left,8"
                                    HorizontalOptions="Fill"
                                    Clicked="OnFinalThumbnailButton" />

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- Upload progress overlay -->
        <Grid x:Name="UploadStatusPanel"
              IsVisible="False"
              BackgroundColor="{StaticResource Filo.Scrim}">

            <Border Style="{StaticResource Filo.ModalSurface}"
                    Padding="28"
                    WidthRequest="300"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                <VerticalStackLayout Spacing="16">
                    <ActivityIndicator x:Name="UploadActivityIndicator"
                                       IsRunning="False"
                                       HorizontalOptions="Center" />

                    <Label x:Name="UploadStatusLabel"
                           Text="Uploading..."
                           Style="{StaticResource Body1}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
