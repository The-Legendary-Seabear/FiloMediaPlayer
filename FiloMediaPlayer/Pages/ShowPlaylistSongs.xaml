<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FiloMediaPlayer.Pages.ShowPlaylistSongs"
    Title="Songs">

    <!-- ===================================================================
         CONTRACT PRESERVED (ShowPlaylistSongs.xaml.cs):
           SongUiCollection, SortModePicker ..... x:Name lookups
           OnSortModeChanged .................... Picker.SelectedIndexChanged
           OnEditMediaClicked ................... Button.Clicked
           OnMediaTapped ........................ MUST stay on a Label
                                                  (handler casts sender is Label)
           Picker.Items strings are reproduced EXACTLY. OnSortModeChanged
           switches on SelectedItem?.ToString(), matching the literals
           "Playlist Order" / "A → Z" / "Z → A" / "Reverse" - so retyping
           "A → Z" with a plain "->" would fall through every case and
           silently leave the sort mode unchanged.
         =================================================================== -->

    <Grid RowDefinitions="Auto,*"
          Padding="{StaticResource Filo.Page.Padding}"
          RowSpacing="16"
          MaximumWidthRequest="{StaticResource Filo.Content.MaxWidth}">

        <!-- Header + sort control -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="16">

            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                <Label Text="Tracks"
                       Style="{StaticResource Filo.PageTitle}" />
                <Label Text="Tap a track to play it."
                       Style="{StaticResource Caption1}" />
            </VerticalStackLayout>

            <Border Grid.Column="1"
                    Style="{StaticResource Filo.InputShell}"
                    VerticalOptions="Center">

                <Picker x:Name="SortModePicker"
                        Title="Sort"
                        WidthRequest="150"
                        SelectedIndexChanged="OnSortModeChanged">
                    <Picker.Items>
                        <x:String>Playlist Order</x:String>
                        <x:String>A → Z</x:String>
                        <x:String>Z → A</x:String>
                        <x:String>Reverse</x:String>
                    </Picker.Items>
                </Picker>
            </Border>
        </Grid>

        <!-- Track list -->
        <CollectionView x:Name="SongUiCollection"
                        Grid.Row="1"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="This playlist is empty.&#10;Add media to it from the playlists screen."
                       Style="{StaticResource Filo.EmptyState}" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Style="{StaticResource Filo.ListRow}">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14">

                            <!-- Artwork with gradient + glyph fallback -->
                            <Border Grid.Column="0"
                                    Style="{StaticResource Filo.ThumbFrame}"
                                    WidthRequest="{StaticResource Filo.Thumb.Row}"
                                    HeightRequest="{StaticResource Filo.Thumb.Row}">

                                <Grid>
                                    <Image Source="{StaticResource Filo.Icon.ThumbPlaceholder}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />

                                    <Image Source="{Binding ThumbnailUrl}"
                                           Aspect="AspectFill"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill" />
                                </Grid>
                            </Border>

                            <!-- Tap target: stretched to fill the cell -->
                            <Label Grid.Column="1"
                                   Text="{Binding Title}"
                                   Style="{StaticResource Filo.ItemTitle}"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   VerticalTextAlignment="Center"
                                   LineBreakMode="TailTruncation">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMediaTapped" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Button Grid.Column="2"
                                    Text="Edit"
                                    Style="{StaticResource Filo.Button.Ghost}"
                                    VerticalOptions="Center"
                                    Clicked="OnEditMediaClicked" />
                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
