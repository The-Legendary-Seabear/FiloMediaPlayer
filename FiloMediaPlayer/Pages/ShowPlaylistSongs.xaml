<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FiloMediaPlayer.Pages.ShowPlaylistSongs"
    Title="Songs">

    <Grid RowDefinitions="Auto,*">

        <!-- Sorting controls -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Padding="10">

            <Picker
                x:Name="SortModePicker"
                Grid.Column="1"
                Title="Sort"
                WidthRequest="140"
                HorizontalOptions="End"
                VerticalOptions="Start"
                SelectedIndexChanged="OnSortModeChanged">

                <Picker.Items>
                    <x:String>Playlist Order</x:String>
                    <x:String>A → Z</x:String>
                    <x:String>Z → A</x:String>
                    <x:String>Reverse</x:String>
                </Picker.Items>

            </Picker>

        </Grid>

        <!-- Media collection -->
        <CollectionView
            x:Name="SongUiCollection"
            Grid.Row="1"
            VerticalOptions="Fill"
            HorizontalOptions="Fill">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Grid
                        ColumnDefinitions="60,*,Auto"
                        ColumnSpacing="12"
                        Padding="10,6">

                        <!-- Media thumbnail -->
                        <Image
                            Grid.Column="0"
                            Source="{Binding ThumbnailUrl}"
                            WidthRequest="60"
                            HeightRequest="60"
                            Aspect="AspectFit" />

                        <!-- Media title / playback -->
                        <Label
                            Grid.Column="1"
                            Text="{Binding Title}"
                            VerticalOptions="Center"
                            LineBreakMode="TailTruncation">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnMediaTapped" />
                            </Label.GestureRecognizers>

                        </Label>

                        <!-- Edit media -->
                        <Button
                            Grid.Column="2"
                            Text="Edit"
                            VerticalOptions="Center"
                            Clicked="OnEditMediaClicked" />

                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
