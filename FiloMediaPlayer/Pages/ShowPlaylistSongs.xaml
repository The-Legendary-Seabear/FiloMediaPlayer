<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FiloMediaPlayer.Pages.ShowPlaylistSongs"
             Title="Songs">
    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="10">

            <Picker
                x:Name="SortModePicker"
    Grid.Column="1"
    Title="Sort"
    WidthRequest="140"
    HorizontalOptions="End"
    VerticalOptions="Start"
    SelectedIndexChanged="OnSortModeChanged">

                <Picker.Items>
                    <x:String>Playlist Order</x:String>
                    <x:String>A → Z</x:String>
                    <x:String>Z → A</x:String>
                    <x:String>Reverse</x:String>
                </Picker.Items>
            </Picker>

        </Grid>

        <CollectionView x:Name="SongUiCollection" HorizontalOptions="Start" VerticalOptions="Center" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout>
                    <Image Source="{Binding ThumbnailUrl}" WidthRequest="60" HeightRequest="60" />
                        <Label Text="{Binding Title}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnMediaTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>