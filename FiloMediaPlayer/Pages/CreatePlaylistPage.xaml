<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FiloMediaPlayer.Pages.CreatePlaylistPage"
             Title="CreatePlaylistPage">
    <Grid RowDefinitions="Auto" ColumnDefinitions="*,Auto">
        <Entry x:Name="PlaylistNameEntry" Placeholder="Enter Name" Grid.Column="0"/>
        <Button x:Name="SubmitPlaylistName" Clicked="OnCreatePlaylist" Text="Submit" Grid.Column="1"/>
    </Grid>
</ContentPage>