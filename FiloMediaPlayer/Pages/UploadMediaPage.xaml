<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FiloMediaPlayer.Pages.UploadMediaPage"
             Title="UploadMediaPage">
    <VerticalStackLayout>
        <Button Clicked="OnUploadMediaButton" HorizontalOptions="Center" VerticalOptions="Center" Text="Upload File"/>
        <Entry x:Name="UserUploadedMediaName" Placeholder="Enter Media Name" />
        <Button Clicked="OnFinalMediaButton" Text="Create Media" HorizontalOptions="Center" VerticalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>