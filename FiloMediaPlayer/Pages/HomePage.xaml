<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FiloMediaPlayer.Pages.HomePage"
             Title="Home Page">

    <!-- Contract preserved: OnCreatePlaylistButton, OnShowPlaylistButton,
         OnAddMediaFileButton and OnCreateThumbnailButton all remain Clicked
         handlers on Button elements, exactly as HomePage.xaml.cs expects. -->

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource Filo.Page.Padding}"
                             Spacing="24"
                             MaximumWidthRequest="{StaticResource Filo.Content.MaxWidth}"
                             HorizontalOptions="Fill">

            <!-- Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Your library"
                       Style="{StaticResource Filo.PageTitle}" />
                <Label Text="Browse playlists, or add something new to Filo."
                       Style="{StaticResource Caption1}" />
            </VerticalStackLayout>

            <!-- Primary destination: the library itself -->
            <Border Style="{StaticResource Filo.Card}"
                    Background="{StaticResource Filo.Brush.HeroWash}"
                    Padding="24">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="20"
                      RowDefinitions="Auto">

                    <VerticalStackLayout Grid.Column="0"
                                         Spacing="6"
                                         VerticalOptions="Center">
                        <Label Text="Playlists"
                               Style="{StaticResource Title2}" />
                        <Label Text="Open your collections and start playing."
                               Style="{StaticResource Caption1}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Browse"
                            Style="{StaticResource Filo.Button.Primary}"
                            Clicked="OnShowPlaylistButton"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Secondary actions -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Add to your library"
                       Style="{StaticResource Filo.SectionTitle}" />

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="12">

                    <Button Grid.Row="0" Grid.Column="0"
                            Text="New playlist"
                            ImageSource="{StaticResource Filo.Icon.PlaylistAddAccent}"
                            ContentLayout="Top,10"
                            Style="{StaticResource Filo.Button.Secondary}"
                            Padding="16,20"
                            HeightRequest="112"
                            Clicked="OnCreatePlaylistButton" />

                    <Button Grid.Row="0" Grid.Column="1"
                            Text="Upload media"
                            ImageSource="{StaticResource Filo.Icon.MediaAccent}"
                            ContentLayout="Top,10"
                            Style="{StaticResource Filo.Button.Secondary}"
                            Padding="16,20"
                            HeightRequest="112"
                            Clicked="OnAddMediaFileButton" />

                    <Button Grid.Row="1" Grid.Column="0"
                            Text="Upload thumbnail"
                            ImageSource="{StaticResource Filo.Icon.ImageAccent}"
                            ContentLayout="Top,10"
                            Style="{StaticResource Filo.Button.Secondary}"
                            Padding="16,20"
                            HeightRequest="112"
                            Clicked="OnCreateThumbnailButton" />

                    <Button Grid.Row="1" Grid.Column="1"
                            Text="All playlists"
                            ImageSource="{StaticResource Filo.Icon.PlaylistAccent}"
                            ContentLayout="Top,10"
                            Style="{StaticResource Filo.Button.Secondary}"
                            Padding="16,20"
                            HeightRequest="112"
                            Clicked="OnShowPlaylistButton" />
                </Grid>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
