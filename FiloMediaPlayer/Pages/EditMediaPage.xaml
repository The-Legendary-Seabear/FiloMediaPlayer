<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:FiloMediaPlayer.Components"
    x:Class="FiloMediaPlayer.Pages.EditMediaPage"
    Title="Edit Media">

    <!-- Contract preserved: MediaTitleEntry (.Text read/written in code),
         ThumbnailPicker (SelectedThumbnailId / Thumbnails set in code),
         OnManagePlaylistsClicked, OnSaveChangesClicked. -->

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="{StaticResource Filo.Page.Padding}"
                                 Spacing="20"
                                 MaximumWidthRequest="{StaticResource Filo.Content.MaxWidth}">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Edit media"
                           Style="{StaticResource Filo.PageTitle}" />
                    <Label Text="Rename this track, choose artwork, or change which playlists it belongs to."
                           Style="{StaticResource Caption1}" />
                </VerticalStackLayout>

                <!-- Details -->
                <Border Style="{StaticResource Filo.Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Media title"
                               Style="{StaticResource Filo.FieldLabel}" />

                        <Border Style="{StaticResource Filo.InputShell}">
                            <Entry x:Name="MediaTitleEntry"
                                   Placeholder="Enter media title"
                                   MaxLength="255" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Artwork -->
                <Border Style="{StaticResource Filo.Card}">
                    <components:ThumbnailPickerView x:Name="ThumbnailPicker" />
                </Border>

                <!-- Playlist membership -->
                <Border Style="{StaticResource Filo.Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Playlists"
                                   Style="{StaticResource Body1Strong}" />
                            <Label Text="Choose which playlists include this media."
                                   Style="{StaticResource Caption1}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Manage playlists"
                                Style="{StaticResource Filo.Button.Secondary}"
                                VerticalOptions="Center"
                                Clicked="OnManagePlaylistsClicked" />
                    </Grid>
                </Border>


                <!-- Media conversion -->
                <Border Style="{StaticResource Filo.Card}">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="Convert media"
               Style="{StaticResource Body1Strong}" />

                        <Label Text="Create a converted copy of this media file. The original will be preserved."
               Style="{StaticResource Caption1}" />

                        <Label Text="Output format"
               Style="{StaticResource Filo.FieldLabel}" />

                        <Border Style="{StaticResource Filo.InputShell}">
                            <Picker x:Name="ConversionFormatPicker" Title="Select output format" SelectedIndexChanged="OnConversionFormatChanged" />
                        </Border>

                        <VerticalStackLayout x:Name="VideoCodecSection"
                             Spacing="8"
                             IsVisible="False">

                            <Label Text="Video codec"
                   Style="{StaticResource Filo.FieldLabel}" />

                            <Border Style="{StaticResource Filo.InputShell}">
                                <Picker x:Name="VideoCodecPicker"
                        Title="Select video codec" />
                            </Border>

                        </VerticalStackLayout>

                        <Button x:Name="ConvertMediaButton"
                Text="Convert media"
                Style="{StaticResource Filo.Button.Primary}"
                Clicked="OnConvertMediaClicked" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Processing status"
                   Style="{StaticResource Filo.FieldLabel}" />

                            <Label x:Name="ConversionStatusLabel"
                   Text="No conversion started."
                   Style="{StaticResource Caption1}" />

                            <ActivityIndicator x:Name="ConversionActivityIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Start" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>


            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky save bar -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource Filo.Surface.Base}"
                Stroke="{StaticResource Filo.Brush.Stroke}"
                StrokeThickness="0"
                StrokeShape="Rectangle"
                Padding="0">
            <Grid RowDefinitions="Auto,Auto">
                <BoxView Grid.Row="0" Style="{StaticResource Filo.Divider}" />

                <Grid Grid.Row="1"
                      Padding="{StaticResource Filo.Page.Padding}"
                      MaximumWidthRequest="{StaticResource Filo.Content.MaxWidth}">
                    <Button Text="Save changes"
                            Style="{StaticResource Filo.Button.Primary}"
                            HorizontalOptions="End"
                            Clicked="OnSaveChangesClicked" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
