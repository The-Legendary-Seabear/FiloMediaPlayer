<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:components="clr-namespace:FiloMediaPlayer.Components"
    x:Class="FiloMediaPlayer.Pages.PlaybackPage"
    Title="PlaybackPage">

    <!--
        Main layout:
        Row 0: Media player and optional bookmark editor
        Row 1: Playback controls
        Row 2: Expandable bookmark panel
    -->
    <Grid RowDefinitions="*,Auto,Auto"
          RowSpacing="0">

        <!-- ========== MEDIA STAGE ========== -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="0"
            BackgroundColor="{StaticResource Filo.Surface.Overlay}">

            <!-- Media player -->
            <toolkit:MediaElement
                x:Name="MediaPlayer"
                Grid.Column="0"
                ShouldAutoPlay="False"
                PositionChanged="OnPositionChanged"
                MediaOpened="OnMediaOpened"
                MediaEnded="OnMediaEnded"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <!-- Audio artwork -->
            <Border
                Grid.Column="0"
                Style="{StaticResource Filo.ThumbFrame}"
                StrokeShape="RoundRectangle 16"
                WidthRequest="300"
                HeightRequest="300"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                IsVisible="{Binding Source={x:Reference MediaThumbnail}, Path=IsVisible}">

                <Image
                    x:Name="MediaThumbnail"
                    IsVisible="False"
                    WidthRequest="250"
                    HeightRequest="250"
                    Aspect="AspectFit"
                    Source="{Binding ThumbnailUrl}" />

            </Border>

            <!-- Bookmark editor sidebar -->
            <Border
                x:Name="BookmarkEditorContainer"
                Grid.Column="1"
                WidthRequest="380"
                MaximumWidthRequest="420"
                BackgroundColor="{StaticResource Filo.Surface.Base}"
                Stroke="{StaticResource Filo.Brush.Stroke}"
                StrokeThickness="1"
                IsVisible="False">

                <!--
                    BookmarkEditorPage is inserted here in code-behind.
                    This allows us to pass the current media ID,
                    playback position, duration, and API service.
                -->
                <ContentView
                    x:Name="BookmarkEditorHost"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />

            </Border>

        </Grid>

        <!-- ========== PLAYBACK CONTROLS ========== -->
        <Border
            Grid.Row="1"
            BackgroundColor="{StaticResource Filo.Surface.Base}"
            Stroke="{StaticResource Filo.Brush.Stroke}"
            StrokeThickness="0"
            StrokeShape="Rectangle"
            Padding="0">

            <Grid
                RowDefinitions="Auto,Auto"
                MaximumWidthRequest="{StaticResource Filo.Content.MaxWidth}">

                <BoxView
                    Grid.Row="0"
                    Style="{StaticResource Filo.Divider}"
                    VerticalOptions="Start" />

                <VerticalStackLayout
                    Grid.Row="1"
                    Padding="{StaticResource Filo.Page.Padding}"
                    Spacing="14">

                    <!-- Now playing -->
                    <VerticalStackLayout Spacing="2">

                        <Label
                            Text="NOW PLAYING"
                            Style="{StaticResource Caption2}"
                            CharacterSpacing="2" />

                        <Label
                            Text="{Binding Title}"
                            Style="{StaticResource Title2}"
                            LineBreakMode="TailTruncation"
                            MaxLines="1" />

                    </VerticalStackLayout>


                    <!-- Playback timeline and bookmark visualization -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
      ColumnSpacing="10">

                        <Label
        x:Name="CurrentTimeLabel"
        Grid.Column="0"
        Text="0:00"
        Style="{StaticResource Filo.TimeCode}"
        VerticalOptions="Start" />



                        <!-- Slider with bookmark indicators overlaid -->
                        <Grid
    x:Name="BookmarkTimelineContainer"
    Grid.Column="1"
    RowDefinitions="Auto">

                            <!-- Playback slider -->
                            <Slider
        x:Name="PlaybackSlider"
        Grid.Row="0"
        Minimum="0"
        DragStarted="OnSeekStarted"
        DragCompleted="OnSeekCompleted"
        VerticalOptions="Center"
        HorizontalOptions="Fill">

                                <Slider.GestureRecognizers>
                                    <PointerGestureRecognizer
                PointerMoved="OnBookmarkTimelinePointerMoved"
                PointerExited="OnBookmarkTimelinePointerExited" />
                                </Slider.GestureRecognizers>

                            </Slider>

                            <!-- Bookmark color overlay -->
                            <GraphicsView
        x:Name="BookmarkTimelineGraphics"
        Grid.Row="0"
        HeightRequest="12"
        HorizontalOptions="Fill"
        VerticalOptions="Center"
        InputTransparent="True" />

                            <!-- Bookmark hover tooltip -->
                            <Border
        x:Name="BookmarkHoverPreview"
        Grid.Row="0"
        IsVisible="False"
        InputTransparent="True"
        BackgroundColor="{StaticResource Filo.Surface.Base}"
        Stroke="{StaticResource Filo.Brush.Stroke}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 8"
        Padding="10,6"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        TranslationY="-34"
        ZIndex="10">

                                <Label
            x:Name="BookmarkHoverLabel"
            FontSize="12"
            LineBreakMode="NoWrap" />

                            </Border>

                        </Grid>

                        <!-- Total duration -->
                        <Label
    x:Name="TotalTimeLabel"
    Grid.Column="2"
    Text="0:00"
    Style="{StaticResource Filo.TimeCode}"
    VerticalOptions="Start" />

                    </Grid>

                    
                    <!-- Transport controls -->
                    <Grid
                        ColumnDefinitions="*,Auto,*"
                        ColumnSpacing="16">

                        <!-- Volume -->
                        <HorizontalStackLayout
                            Grid.Column="0"
                            Spacing="8"
                            VerticalOptions="Center"
                            HorizontalOptions="Start">

                            <Image
                                Source="{StaticResource Filo.Icon.Volume}"
                                VerticalOptions="Center" />

                            <Slider
                                x:Name="VolumeSlider"
                                Minimum="0"
                                Maximum="1"
                                Value="1"
                                WidthRequest="130"
                                VerticalOptions="Center"
                                Style="{StaticResource Filo.Slider.Volume}"
                                ValueChanged="OnVolumeChanged" />

                        </HorizontalStackLayout>

                        <!-- Previous / Play / Next / Loop -->
                        <HorizontalStackLayout
                            Grid.Column="1"
                            Spacing="12"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Button
                                x:Name="PreviousButton"
                                ImageSource="{StaticResource Filo.Icon.Previous}"
                                ToolTipProperties.Text="Previous"
                                Style="{StaticResource Filo.Button.Transport}"
                                Clicked="OnPreviousClicked" />

                            <Button
                                x:Name="PlayPauseButton"
                                Text="Pause"
                                Style="{StaticResource Filo.Button.PlayPause}"
                                Clicked="OnPlayPauseClicked" />

                            <Button
                                x:Name="NextButton"
                                ImageSource="{StaticResource Filo.Icon.Next}"
                                ToolTipProperties.Text="Next"
                                Style="{StaticResource Filo.Button.Transport}"
                                Clicked="OnNextClicked" />

                            <Button
                                x:Name="LoopButton"
                                Text="Loop"
                                Style="{StaticResource Filo.Button.TransportPill}"
                                Clicked="OnLoopButtonClicked" />

                        </HorizontalStackLayout>

                        <!-- Playback mode -->
                        <HorizontalStackLayout
                            Grid.Column="2"
                            Spacing="8"
                            VerticalOptions="Center"
                            HorizontalOptions="End">

                            <Image
                                Source="{StaticResource Filo.Icon.Shuffle}"
                                VerticalOptions="Center" />

                            <Border
                                Style="{StaticResource Filo.InputShell}"
                                VerticalOptions="Center">

                                <Picker
                                    x:Name="PlaybackModePicker"
                                    WidthRequest="168"
                                    SelectedIndexChanged="OnPlaybackModeChanged">

                                    <Picker.Items>
                                        <x:String>Normal</x:String>
                                        <x:String>Shuffle All</x:String>
                                        <x:String>Random No Repeat</x:String>
                                        <x:String>True Random</x:String>
                                    </Picker.Items>

                                </Picker>

                            </Border>

                        </HorizontalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Grid>

        </Border>

        <!-- ========== BOOKMARK PANEL ========== -->
        <components:BookmarkPanelComponent
            x:Name="BookmarkPanel"
            Grid.Row="2"
            HorizontalOptions="Fill" />

    </Grid>

</ContentPage>
