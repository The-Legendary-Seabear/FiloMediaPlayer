<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:FiloMediaPlayer.Components"
    x:Class="FiloMediaPlayer.Pages.EditPlaylistPage"
    Title="Edit Playlist">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="15">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="10">

            <Label
                Text="Playlist Name"
                FontAttributes="Bold" />

            <Entry
                x:Name="PlaylistNameEntry"
                Placeholder="Enter playlist name"
                MaxLength="255" />

        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15">

                <components:ThumbnailPickerView
                    x:Name="ThumbnailPicker" />

                <Button
                    Text="Manage Playlist Media"
                    Clicked="OnManageMediaClicked" />

            </VerticalStackLayout>
        </ScrollView>

        <Button
            Grid.Row="2"
            Text="Save Changes"
            Clicked="OnSaveChangesClicked" />

    </Grid>

</ContentPage>
